{
  "name": "afc-form-print-video",
  "version": "1.0.0",
  "private": true,
  "description": "Video hướng dẫn thao tác Phiếu xuất kho Giấy A.F.C (Remotion)",
  "scripts": {
    "dev": "remotion studio",
    "typecheck": "tsc --noEmit",
    "render": "remotion render src/index.ts Tutorial out/huong-dan-phieu-xuat-kho-thuyet-minh.mp4 --audio-codec=aac",
    "narrate": "node scripts/narrate.mjs",
    "narrate:short": "NARRATION=short node scripts/narrate.mjs",
    "render:short": "remotion render src/index.ts TutorialShort out/huong-dan-phieu-xuat-kho-ngan.mp4 --audio-codec=aac",
    "narrate:user": "NARRATION=user node scripts/narrate.mjs",
    "narrate:manager": "NARRATION=manager node scripts/narrate.mjs",
    "render:user": "remotion render src/index.ts TutorialUser out/huong-dan-nhan-vien-nhap-in.mp4 --audio-codec=aac",
    "render:manager": "remotion render src/index.ts TutorialManager out/huong-dan-quan-ly-bao-cao.mp4 --audio-codec=aac"
  },
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "typescript": "5.9.3"
  }
}
